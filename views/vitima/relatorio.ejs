<!DOCTYPE html>
<html lang="pt-br" data-bs-theme="dark">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Relatório de Vítimas</title>
  <%- include('../partials/cabecalho') %>
  <%- include('../partials/menu') %>
</head>
<body>
  <div class='container'>
    <br>
    <h3>Relatório de Vítimas</h3>

    <% if(status == '1'){%>
      <div class="alert alert-success alert-dismissible">
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        Cadastrado com <b>Sucesso!</b>
      </div>
    <%}%>

    <div class="table-responsive">
      <table class="table table-striped table-dark table-hover align-middle">
        <thead>
          <tr>
            <th>Nome</th>
            <th>CPF</th>
            <th class="d-nome d-sm-table-cell">Data de Nascimento</th><!--oculta quando em mobile-->
            <th class="d-none d-sm-table-cell">Filiação</th> <!--oculta quando em mobile--> 
            <th>Endereço</th> 
            <th class="d-nome d-sm-table-cell">Telefone</th><!--oculta quando em mobile-->
            <th class="d-none d-sm-table-cell">Grau de Escolaridade</th><!--oculta quando em mobile-->
            <th>Ações</th>
          </tr>
        </thead>
        <tbody>
          <% vitimas.forEach(vitima => { %>
            <tr>
              <td><%= vitima.nome %></td>
              <td><%= vitima.cpf %></td>
              <td><%= vitima.dataNascimento.toISOString().substring(0,10) %></td>
              <td class="d-none d-sm-table-cell"><%= vitima.filiacao %></td>
              <td><%= vitima.endereco %></td>
              <td><%= vitima.telefone %></td>
              <td class="d-none d-sm-table-cell"><%= vitima.grauEscolaridade %></td>
              <td>
                <div class="d-flex flex-wrap gap-1">
                  <a href="/vitimas/<%= vitima._id %>" class="btn btn-primary btn-sm" data-bs-toggle="tooltip" title="Detalhes da vítima">
                    <i class="bi bi-info-circle"></i>
                  </a>
                  <a href="/vitimas/editar/<%= vitima._id %>" class="btn btn-warning btn-sm" data-bs-toggle="tooltip" title="Atualizar vítima">
                    <i class="bi bi-pencil"></i>
                  </a>
                  <form action="/vitimas/<%= vitima._id %>/remover" method="POST" style="display:inline;" onsubmit="return confirm('Tem certeza que deseja excluir esta vítima?');">
                    <button type="submit" class="btn btn-danger btn-sm" data-bs-toggle="tooltip" title="Excluir vítima">
                      <i class="bi bi-trash"></i>
                    </button>
                  </form>
                </div>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  </div>

  <%- include('../partials/rodape') %>
</body>
</html>
